@model IEnumerable<CinemaMvc.Models.Screening>

@{
    ViewData["Title"] = "Screenings";
}

<h2>Screenings</h2>

@if (User.IsInRole("Admin"))
{
    <p>
        <a asp-action="Create" class="btn btn-primary">Create Screening</a>
    </p>
}

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Film title</th>
            <th>Start time</th>
            <th>Cinema</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.FilmTitle</td>
            <td>@item.StartTime</td>
            <td>@item.Cinema?.Name</td>
            <td>
                <a asp-controller="Reservations" asp-action="Seats" asp-route-screeningId="@item.Id" class="btn btn-sm btn-primary">Seats</a>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
